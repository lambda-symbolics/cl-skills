#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd -- "$root"

if [ ! -r "$root/.qlot/setup.lisp" ]; then
  printf '%s\n' 'cl-skills dependencies are missing; run ./script/bootstrap.' >&2
  exit 1
fi

exec sbcl --noinform --non-interactive \
  --load "$root/.qlot/setup.lisp" \
  --eval '(require :asdf)' \
  --eval '(asdf:initialize-source-registry (list :source-registry (list :directory (uiop:getcwd)) :inherit-configuration))' \
  --eval '(asdf:load-asd (truename "cl-skills.asd"))' \
  --eval '(asdf:test-system "cl-skills")' \
  --eval '(asdf:test-system "cl-skills/executable")'
